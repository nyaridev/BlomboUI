{
  "name": "NoobAI",
  "apply": [
    "sampler",
    "scheduler",
    "steps",
    "clipSkip",
    "cfg",
    "seed",
    "outputPath"
  ],
  "extras": ["hires"],
  "ports": {
    "IMAGE": ["9", 0],
    "MODEL": ["12", 0],
    "CLIP": ["13", 0],
    "VAE": ["1", 2],
    "POSITIVE": ["2", 0],
    "NEGATIVE": ["3", 0]
  },
  "1": {
    "inputs": {
      "ckpt_name": ""
    },
    "class_type": "CheckpointLoaderSimple",
    "_meta": {
      "title": "Load Checkpoint"
    }
  },
  "2": {
    "inputs": {
      "text": "",
      "clip": ["13", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive"
    }
  },
  "3": {
    "inputs": {
      "text": "",
      "clip": ["13", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative"
    }
  },
  "5": {
    "inputs": {
      "seed": 0,
      "steps": 24,
      "cfg": 7,
      "sampler_name": "euler_ancestral",
      "scheduler": "sgm_uniform",
      "denoise": 1,
      "model": ["12", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["7", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "7": {
    "inputs": {
      "width": 832,
      "height": 1216,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent Image"
    }
  },
  "9": {
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "10": {
    "inputs": {
      "filename_prefix": "blombo",
      "images": ["9", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save First Pass"
    }
  },
  "11": {
    "inputs": {
      "filename_prefix": "blombo",
      "images": ["9", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  },
  "12": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": ["1", 0],
      "clip": ["1", 1]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "Power Lora Loader (rgthree)"
    }
  },
  "13": {
    "inputs": {
      "stop_at_clip_layer": -2,
      "clip": ["12", 1]
    },
    "class_type": "CLIPSetLastLayer",
    "_meta": {
      "title": "CLIP Set Last Layer"
    }
  }
}
