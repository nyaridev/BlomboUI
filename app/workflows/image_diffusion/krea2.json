{
  "name": "Krea2",
  "apply": [
    "sampler",
    "scheduler",
    "steps",
    "clipType",
    "clipDevice",
    "cfg",
    "seed",
    "outputPath"
  ],
  "extras": ["hires"],
  "defaults": { "resMode": "scaler", "aspect": "3:4", "megapixels": 1.5 },
  "ports": {
    "IMAGE": ["9", 0],
    "MODEL": ["15", 0],
    "CLIP": ["18", 0],
    "VAE": ["17", 0],
    "POSITIVE": ["2", 0],
    "NEGATIVE": ["3", 0]
  },
  "2": {
    "inputs": {
      "text": "",
      "clip": ["18", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive"
    }
  },
  "3": {
    "inputs": {
      "text": "",
      "clip": ["18", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative"
    }
  },
  "5": {
    "inputs": {
      "seed": 0,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1,
      "model": ["15", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["7", 0]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "7": {
    "inputs": {
      "width": 1064,
      "height": 1416,
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent Image"
    }
  },
  "9": {
    "inputs": {
      "samples": ["5", 0],
      "vae": ["17", 0]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "10": {
    "inputs": {
      "filename_prefix": "blombo",
      "images": ["9", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save First Pass"
    }
  },
  "11": {
    "inputs": {
      "filename_prefix": "blombo",
      "images": ["9", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  },
  "15": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": ["19", 0]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "Power Lora Loader (rgthree)"
    }
  },
  "17": {
    "inputs": {
      "vae_name": ""
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    }
  },
  "18": {
    "inputs": {
      "clip_name": "",
      "type": "krea2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP"
    }
  },
  "19": {
    "inputs": {
      "unet_name": "",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    }
  }
}
