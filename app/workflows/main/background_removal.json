{
  "name": "Background Removal",
  "category": "utility",
  "apply": ["rembg", "outputPath"],
  "extras": ["rembg"],
  "1": {
    "inputs": {
      "image": "example.png"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Load Image"
    }
  },
  "2": {
    "inputs": {
      "image": ["1", 0],
      "model": "RMBG-2.0",
      "sensitivity": 1,
      "process_res": 1024,
      "mask_blur": 0,
      "mask_offset": 0,
      "invert_output": false,
      "refine_foreground": false,
      "background": "Alpha",
      "background_color": "#222222"
    },
    "class_type": "RMBG",
    "_meta": {
      "title": "Remove Background (RMBG)"
    }
  },
  "3": {
    "inputs": {
      "image": ["1", 0],
      "model": "BiRefNet-general",
      "sensitivity": 1,
      "mask_blur": 0,
      "mask_offset": 0,
      "invert_output": false,
      "refine_foreground": false,
      "background": "Alpha",
      "background_color": "#222222"
    },
    "class_type": "BiRefNetRMBG",
    "_meta": {
      "title": "BiRefNet Remove Background (RMBG)"
    }
  },
  "4": {
    "inputs": {
      "filename_prefix": "blombo",
      "images": ["2", 0]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
