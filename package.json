{
  "name": "blombo-ui",
  "version": "1.0.0",
  "private": true,
  "description": "BlomboUI: a profile-based studio for ComfyUI with importable workflows, a customizable Generate screen, gallery, models and wildcards.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node tools/dev-server.ts --dev --port 4381 --open none",
    "dev:web": "vite --open",
    "dev:headless": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"vite\"",
    "dev:app": "concurrently -k -n server,web,app -c yellow,cyan,magenta \"npm:dev:server\" \"vite\" \"npm:app:dev-window\"",
    "app:dev-window": "node tools/ensure-app.ts && node tools/dev-window.ts",
    "build": "vite build",
    "build:app": "tauri build --no-bundle",
    "start": "node tools/ensure-build.ts && node src/server/main.ts --open web",
    "start:app": "node tools/ensure-build.ts && node tools/ensure-app.ts && node src/server/main.ts --open app",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && node tools/sync-rules.ts --check",
    "rules:sync": "node tools/sync-rules.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-virtual": "^3.14.20",
    "@tauri-apps/api": "^2.12.4",
    "fflate": "^0.8.3",
    "hono": "^4.13.13",
    "motion": "^14.2.0",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
