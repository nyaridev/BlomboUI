{
  "format": "blombo.layout/1",
  "id": "compact",
  "name": "Compact",
  "regions": {
    "models": [
      {
        "type": "feature",
        "feature": "loaded-models",
        "id": "models"
      }
    ],
    "prompt": [
      {
        "type": "feature",
        "feature": "prompts",
        "id": "prompts"
      }
    ],
    "actions": [
      {
        "type": "feature",
        "feature": "generate-actions",
        "id": "actions"
      }
    ],
    "params": [
      {
        "type": "card",
        "id": "card-sampling",
        "title": "Sampling",
        "icon": "activity",
        "children": [
          {
            "type": "param",
            "id": "p-sampler",
            "bind": "role:sampler.name",
            "control": "select",
            "span": 12,
            "size": "sm"
          },
          {
            "type": "param",
            "id": "p-scheduler",
            "bind": "role:sampler.scheduler",
            "control": "segmented",
            "span": 12,
            "size": "sm"
          },
          {
            "type": "param",
            "id": "p-steps",
            "bind": "role:sampler.steps",
            "control": "scrub",
            "span": 6,
            "size": "sm"
          },
          {
            "type": "param",
            "id": "p-cfg",
            "bind": "role:sampler.cfg",
            "control": "scrub",
            "span": 6,
            "size": "sm"
          },
          {
            "type": "param",
            "id": "p-clipskip",
            "bind": "role:clip.skip",
            "control": "chips",
            "span": 12,
            "size": "sm"
          }
        ]
      },
      {
        "type": "feature",
        "feature": "seed",
        "id": "seed"
      },
      {
        "type": "feature",
        "feature": "resolution",
        "id": "resolution"
      },
      {
        "type": "stage",
        "stage": "hires",
        "id": "stage-hires"
      },
      {
        "type": "stage",
        "stage": "adetailer",
        "id": "stage-adetailer"
      },
      {
        "type": "stage",
        "stage": "controlnet",
        "id": "stage-controlnet"
      },
      {
        "type": "params-rest",
        "id": "rest",
        "title": "More from this workflow"
      }
    ],
    "stage": [
      {
        "type": "feature",
        "feature": "image-stage",
        "id": "stage"
      }
    ]
  },
  "sizes": {
    "params": 380
  }
}
