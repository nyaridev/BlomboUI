{
  "format": "blombo.layout/1",
  "id": "default",
  "name": "Default",
  "regions": {
    "models": [
      {
        "type": "feature",
        "feature": "loaded-models",
        "id": "models"
      }
    ],
    "prompt": [
      {
        "type": "feature",
        "feature": "prompts",
        "id": "prompts"
      }
    ],
    "actions": [
      {
        "type": "feature",
        "feature": "generate-actions",
        "id": "actions"
      }
    ],
    "params": [
      {
        "type": "tabs",
        "id": "passes",
        "children": [
          {
            "type": "card",
            "id": "card-first-pass",
            "title": "First pass",
            "icon": "activity",
            "children": [
              {
                "type": "param",
                "id": "p-sampler",
                "bind": "role:sampler.name",
                "control": "select",
                "span": 4
              },
              {
                "type": "param",
                "id": "p-scheduler",
                "bind": "role:sampler.scheduler",
                "control": "select",
                "span": 4
              },
              {
                "type": "param",
                "id": "p-steps",
                "bind": "role:sampler.steps",
                "control": "slider",
                "span": 4
              },
              {
                "type": "feature",
                "feature": "resolution",
                "id": "resolution"
              },
              {
                "type": "param",
                "id": "p-clipskip",
                "bind": "role:clip.skip",
                "control": "slider",
                "span": 6
              },
              {
                "type": "param",
                "id": "p-cfg",
                "bind": "role:sampler.cfg",
                "control": "slider",
                "span": 6
              },
              {
                "type": "feature",
                "feature": "seed",
                "id": "seed"
              }
            ]
          },
          {
            "type": "stage",
            "stage": "controlnet",
            "id": "stage-controlnet"
          },
          {
            "type": "stage",
            "stage": "hires",
            "id": "stage-hires"
          },
          {
            "type": "stage",
            "stage": "adetailer",
            "id": "stage-adetailer"
          }
        ]
      },
      {
        "type": "params-rest",
        "id": "rest",
        "title": "More from this workflow"
      },
      {
        "type": "feature",
        "feature": "scripts",
        "id": "scripts"
      }
    ],
    "stage": [
      {
        "type": "feature",
        "feature": "image-stage",
        "id": "stage"
      }
    ]
  }
}
