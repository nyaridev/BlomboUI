{
  "p-image": {
    "class_type": "PORT:IMAGE",
    "inputs": {}
  },
  "p-model": {
    "class_type": "PORT:MODEL",
    "inputs": {}
  },
  "p-clip": {
    "class_type": "PORT:CLIP",
    "inputs": {}
  },
  "p-vae": {
    "class_type": "PORT:VAE",
    "inputs": {}
  },
  "p-pos": {
    "class_type": "PORT:POSITIVE",
    "inputs": {
      "from": "base"
    }
  },
  "detector": {
    "class_type": "UltralyticsDetectorProvider",
    "inputs": {
      "model_name": ""
    },
    "_meta": {
      "title": "Detector"
    }
  },
  "sam": {
    "class_type": "SAMLoader",
    "inputs": {
      "model_name": "",
      "device_mode": "AUTO"
    },
    "_meta": {
      "title": "SAM",
      "blombo": {
        "when": "sam"
      }
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": [
        "p-clip",
        0
      ]
    },
    "_meta": {
      "title": "Prompt",
      "blombo": {
        "when": "prompt",
        "else": "node:p-pos"
      }
    }
  },
  "neg": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "pos",
        0
      ]
    },
    "_meta": {
      "title": "Empty negative"
    }
  },
  "detailer": {
    "class_type": "FaceDetailer",
    "inputs": {
      "image": [
        "p-image",
        0
      ],
      "model": [
        "p-model",
        0
      ],
      "clip": [
        "p-clip",
        0
      ],
      "vae": [
        "p-vae",
        0
      ],
      "guide_size": 512,
      "guide_size_for": true,
      "max_size": 1024,
      "seed": 0,
      "steps": 20,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "denoise": 0.4,
      "feather": 5,
      "noise_mask": true,
      "force_inpaint": true,
      "bbox_threshold": 0.5,
      "bbox_dilation": 10,
      "bbox_crop_factor": 3,
      "sam_detection_hint": "center-1",
      "sam_dilation": 0,
      "sam_threshold": 0.93,
      "sam_bbox_expansion": 0,
      "sam_mask_hint_threshold": 0.7,
      "sam_mask_hint_use_negative": "False",
      "drop_size": 10,
      "bbox_detector": [
        "detector",
        0
      ],
      "wildcard": "",
      "cycle": 1,
      "sam_model_opt": [
        "sam",
        0
      ],
      "segm_detector_opt": [
        "detector",
        1
      ]
    },
    "_meta": {
      "title": "Detailer",
      "blombo": {
        "inputsWhen": {
          "segm_detector_opt": "segm"
        }
      }
    }
  },
  "out-image": {
    "class_type": "OUT:IMAGE",
    "inputs": {
      "value": [
        "detailer",
        0
      ]
    }
  }
}
