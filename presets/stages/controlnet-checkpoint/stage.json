{
  "format": "blombo.stage/1",
  "id": "controlnet-checkpoint",
  "stage": "controlnet",
  "family": "checkpoint",
  "name": "ControlNet",
  "description": "Guides the image with a control map (pose, edges, depth…) made from an image by a comfyui_controlnet_aux preprocessor, or used as it is.",
  "attach": "before_sampler",
  "requires": ["POSITIVE", "NEGATIVE"],
  "provides": ["POSITIVE", "NEGATIVE"],
  "packs": [
    {
      "name": "ControlNet Auxiliary Preprocessors",
      "url": "https://github.com/Fannovel16/comfyui_controlnet_aux",
      "ref": "a587a4c1594524c1d2de5cd1a86cd868ff448e1c",
      "nodes": ["AIO_Preprocessor"]
    }
  ],
  "fields": [
    { "field": "image", "node": "image", "input": "image" },
    { "field": "preprocessor", "node": "preprocess", "input": "preprocessor", "label": "Preprocessor" },
    { "field": "resolution", "node": "preprocess", "input": "resolution" },
    { "field": "model", "node": "loader", "input": "control_net_name", "modelKind": "controlnet", "label": "ControlNet model" },
    { "field": "strength", "node": "apply", "input": "strength" },
    { "field": "start", "node": "apply", "input": "start_percent" },
    { "field": "end", "node": "apply", "input": "end_percent" }
  ],
  "defaults": {}
}
