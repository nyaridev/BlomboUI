{
  "load": { "class_type": "LoadVideo", "inputs": { "file": "" }, "_meta": { "title": "The video so far" } },
  "parts": { "class_type": "GetVideoComponents", "inputs": { "video": ["load", 0] }, "_meta": { "title": "Its frames" } },
  "p-image": { "class_type": "PORT:IMAGE", "inputs": {} },
  "last": {
    "class_type": "ImageFromBatch",
    "inputs": { "image": ["parts", 0], "batch_index": -1, "length": 1 },
    "_meta": { "title": "Its last frame" }
  },
  "match": {
    "class_type": "ColorTransfer",
    "inputs": {
      "image_target": ["p-image", 0],
      "image_ref": ["last", 0],
      "method": "reinhard_lab",
      "source_stats": "per_frame",
      "strength": 1
    },
    "_meta": { "title": "Match the colors" }
  },
  "new": {
    "class_type": "ImageFromBatch",
    "inputs": { "image": ["match", 0], "batch_index": 5, "length": 4096 },
    "_meta": { "title": "The new frames" }
  },
  "joined": {
    "class_type": "BatchImagesNode",
    "inputs": { "images.image0": ["parts", 0], "images.image1": ["new", 0] },
    "_meta": { "title": "The whole video" }
  },
  "out-image": { "class_type": "OUT:IMAGE", "inputs": { "value": ["joined", 0] } },
  "p-sound": { "class_type": "PORT:SOUND", "inputs": { "optional": true } },
  "new-sound": {
    "class_type": "TrimAudioDuration",
    "inputs": { "audio": ["p-sound", 0], "start_index": 0.2, "duration": 100000 },
    "_meta": { "title": "The new part's sound, after the frames it shares" }
  },
  "sound": {
    "class_type": "AudioConcat",
    "inputs": { "audio1": ["parts", 1], "audio2": ["new-sound", 0], "direction": "after" },
    "_meta": { "title": "The whole sound" }
  },
  "out-sound": { "class_type": "OUT:SOUND", "inputs": { "value": ["sound", 0] } }
}
