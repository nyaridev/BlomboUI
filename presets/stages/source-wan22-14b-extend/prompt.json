{
  "p-pos": {
    "class_type": "PORT:POSITIVE",
    "inputs": {}
  },
  "p-neg": {
    "class_type": "PORT:NEGATIVE",
    "inputs": {}
  },
  "p-vae": {
    "class_type": "PORT:VAE",
    "inputs": {}
  },
  "load": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": ""
    },
    "_meta": {
      "title": "The video so far"
    }
  },
  "parts": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "load",
        0
      ]
    },
    "_meta": {
      "title": "Its frames and sound"
    }
  },
  "tail": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "parts",
        0
      ],
      "batch_index": -5,
      "length": 5
    },
    "_meta": {
      "title": "Its last frames"
    }
  },
  "video": {
    "class_type": "WanImageToVideo",
    "inputs": {
      "positive": [
        "p-pos",
        0
      ],
      "negative": [
        "p-neg",
        0
      ],
      "vae": [
        "p-vae",
        0
      ],
      "width": 640,
      "height": 640,
      "length": 81,
      "batch_size": 1,
      "start_image": [
        "tail",
        0
      ]
    },
    "_meta": {
      "title": "Video from the last frames"
    }
  },
  "out-pos": {
    "class_type": "OUT:POSITIVE",
    "inputs": {
      "value": [
        "video",
        0
      ]
    }
  },
  "out-neg": {
    "class_type": "OUT:NEGATIVE",
    "inputs": {
      "value": [
        "video",
        1
      ]
    }
  },
  "out-video": {
    "class_type": "OUT:VIDEO",
    "inputs": {
      "value": [
        "video",
        2
      ]
    }
  },
  "p-image": {
    "class_type": "PORT:IMAGE",
    "inputs": {}
  },
  "last": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "parts",
        0
      ],
      "batch_index": -1,
      "length": 1
    },
    "_meta": {
      "title": "Its last frame"
    }
  },
  "match": {
    "class_type": "ColorTransfer",
    "inputs": {
      "image_target": [
        "p-image",
        0
      ],
      "image_ref": [
        "last",
        0
      ],
      "method": "reinhard_lab",
      "source_stats": "uniform",
      "strength": 1
    },
    "_meta": {
      "title": "Match the colors"
    }
  },
  "new": {
    "class_type": "ImageFromBatch",
    "inputs": {
      "image": [
        "match",
        0
      ],
      "batch_index": 5,
      "length": 4096
    },
    "_meta": {
      "title": "The new frames"
    }
  },
  "fit": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "parts",
        0
      ],
      "upscale_method": "lanczos",
      "width": 1024,
      "height": 576,
      "crop": "center"
    },
    "_meta": {
      "title": "Fit the earlier frames",
      "blombo": {
        "when": "resize",
        "else": "input:image"
      }
    }
  },
  "joined": {
    "class_type": "BatchImagesNode",
    "inputs": {
      "images.image0": [
        "fit",
        0
      ],
      "images.image1": [
        "new",
        0
      ]
    },
    "_meta": {
      "title": "The whole video"
    }
  },
  "out-image": {
    "class_type": "OUT:IMAGE",
    "inputs": {
      "value": [
        "joined",
        0
      ]
    }
  }
}
