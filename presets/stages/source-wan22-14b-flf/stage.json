    "NEGATIVE",
    "VIDEO"
  ],
  "packs": [],
  "fields": [
    {
      "field": "image",
      "node": "first",
      "input": "image",
      "label": "First frame"
    },
    {
      "field": "last",
      "node": "last",
      "input": "image",
      "label": "Last frame"
    },
    {
      "field": "width",
      "node": "video",
      "input": "width"
    },
    {
      "field": "height",
      "node": "video",
      "input": "height"
    },
    {
      "field": "length",
      "node": "video",
      "input": "length"
    },
    {
      "field": "batch",
      "node": "video",
      "input": "batch_size"
    }
