        "wd-vit-tagger-v3",
        "wd-swinv2-tagger-v3",
        "wd-convnext-tagger-v3",
        "wd-v1-4-moat-tagger-v2",
        "wd-v1-4-convnextv2-tagger-v2",
        "wd-v1-4-convnext-tagger-v2",
        "wd-v1-4-convnext-tagger",
        "wd-v1-4-vit-tagger-v2",
        "wd-v1-4-swinv2-tagger-v2",
        "wd-v1-4-vit-tagger"
      ],
      "group": "Tagger"
    },
    {
      "id": "n4.threshold",
      "node": "4",
      "input": "threshold",
      "type": "float",
