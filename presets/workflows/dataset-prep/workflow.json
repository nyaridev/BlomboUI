      "hidden": false,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "group": "Tagger"
    },
    {
      "id": "n4.character_threshold",
      "node": "4",
      "input": "character_threshold",
      "type": "float",
      "label": "Tagger · Character threshold",
      "hidden": false,
      "min": 0,
      "max": 1,
      "step": 0.05,
      "group": "Tagger"
    },
    {
      "id": "n4.replace_underscore",
      "node": "4",
      "input": "replace_underscore",
      "type": "bool",
      "label": "Tagger · Replace underscore",
      "hidden": false,
      "group": "Tagger"
    },
    {
      "id": "n4.trailing_comma",
      "node": "4",
      "input": "trailing_comma",
      "type": "bool",
      "label": "Tagger · Trailing comma",
      "hidden": false,
