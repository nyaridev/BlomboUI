      "step": 1,
      "group": "Training size"
    },
    {
      "id": "n2.height",
      "node": "2",
      "input": "height",
      "type": "int",
      "label": "Training size · Height",
      "hidden": false,
      "min": 0,
      "max": 16384,
      "step": 1,
      "group": "Training size"
    },
    {
      "id": "n2.crop",
      "node": "2",
      "input": "crop",
      "type": "enum",
      "label": "Training size · Crop",
