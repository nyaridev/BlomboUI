{
  "format": "blombo.workflow/1",
  "id": "dataset-prep",
  "name": "Dataset prep",
  "kind": "batch",
  "family": "Utility",
  "description": "Crops and resizes each image to a training size and writes WD14 tags next to it, ready for LoRA training.",
  "tags": [],
  "parentId": null,
  "preset": {
    "id": "dataset-prep",
    "version": 1
  },
  "bindings": [
